# Environment files — never commit secrets. .env.example / .env.*.example
# stay tracked as documented templates.
.env
.env.*
!.env.example
!.env.*.example

# Personal interview-prep explainer — local only, never committed.
# It is human-maintained narrative documentation, not part of the codebase.
PROJECT_EXPLAINER.md

# Personal docs — case studies, rate cards, outreach drafts, freelance/job-hunt
# material. Local only, never committed.
private/

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files — they likely contain sensitive data (passwords,
# private keys, account IDs). Never commit them. Use terraform.tfvars.example
# as the documented template instead.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Terraform provider lock file (.terraform.lock.hcl) is committed deliberately
# — pins provider versions + checksums so plans are reproducible across
# machines and CI. Regenerate only via `terraform init -upgrade`.

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Pluralith local output
.pluralith/

# Lambda build artifacts — rebuilt by scripts/build-lambdas.sh before
# `terraform apply`. Closes backlog #20: applies no longer run npm install.
modules/**/lambda_function/*.zip
modules/**/lambda_function_*/*.zip
modules/slo/lambda_function.zip
modules/**/lambda_function/**/node_modules/
modules/**/lambda_function_*/node_modules/
modules/**/lambdas/**/node_modules/
modules/**/lambda_function/**/*.zip
modules/**/lambdas/**/*.zip
modules/slo/lambda_function/node_modules/
modules/**/.build/

# Local tool downloads (kubeconform, etc) — closes backlog #35.
.tools/
.cache/

# Library package build output
libraries/**/node_modules/
libraries/**/dist/
libraries/**/target/
libraries/**/build/
libraries/**/bin/
libraries/**/obj/
libraries/**/__pycache__/
libraries/**/*.pyc
libraries/**/.coverage*
libraries/**/coverage.out
libraries/**/coverage.xml
libraries/**/coverage.cobertura.xml
libraries/**/htmlcov/
libraries/**/TestResults/

# Compiled TypeScript output for the order-api app (#64).
apps/order-api/dist/

# C++ build outputs (CMake/Ninja) and gcovr reports.
libraries/cpp/logs/build/
libraries/cpp/logs/build-*/
libraries/cpp/logs/coverage.html*
libraries/cpp/logs/coverage-summary.txt

# Go coverage artifacts (regenerated each run).
libraries/go/logs/coverage.out
libraries/go/logs/coverage.html
libraries/go/logs/coverage-summary.txt

# Local Python coverage data.
.coverage

# Java / .NET build outputs.
libraries/java/logs/target/
libraries/dotnet/logs/bin/
libraries/dotnet/logs/obj/
libraries/dotnet/logs/tests/bin/
libraries/dotnet/logs/tests/obj/
STOREFRONT_REDESIGN.md

# CMake system-information probes left by local .NET/C++ builds
__cmake_systeminformation/
