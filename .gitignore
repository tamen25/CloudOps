# Personal interview-prep explainer — local only, never committed.
# Agents (including Claude) must NOT read this file for context.
# It is human-maintained narrative documentation, not part of the codebase.
PROJECT_EXPLAINER.md

# Personal docs — case studies, rate cards, outreach drafts, freelance/job-hunt
# material. Local only, never committed.
private/

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files — they likely contain sensitive data (passwords,
# private keys, account IDs). Never commit them. Use terraform.tfvars.example
# as the documented template instead.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Terraform provider lock file (.terraform.lock.hcl) is committed deliberately
# — pins provider versions + checksums so plans are reproducible across
# machines and CI. Regenerate only via `terraform init -upgrade`.

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Claude Code local settings (contains personal configuration)
.claude/
CLAUDE.md

# Pluralith local output
.pluralith/

# Lambda build artifacts — rebuilt by scripts/build-lambdas.sh before
# `terraform apply`. Closes backlog #20: applies no longer run npm install.
modules/**/lambda_function/*.zip
modules/**/lambda_function_*/*.zip
modules/slo/lambda_function.zip
modules/**/lambda_function/**/node_modules/
modules/**/lambda_function_*/node_modules/
modules/slo/lambda_function/node_modules/

# Local tool downloads (kubeconform, etc) — closes backlog #35.
.tools/
