{
  "name": "cloudops",
  "private": true,
  "description": "Root delegator — the app lives at apps/order-api/. These scripts forward to that package so `npm test` / `npm run lint` work from the repo root.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "npm test --prefix apps/order-api",
    "test:coverage": "npm run test:coverage --prefix apps/order-api",
    "lint": "npm run lint --prefix apps/order-api",
    "audit": "npm run audit --prefix apps/order-api",
    "contract-check": "npm run contract-check --prefix apps/order-api",
    "libraries:check:nodejs": "bash scripts/publish-node-packages.sh --check",
    "libraries:publish:nodejs": "bash scripts/publish-node-packages.sh"
  }
}
