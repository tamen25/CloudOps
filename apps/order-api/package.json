{
  "name": "order-api",
  "version": "1.0.0",
  "description": "CloudOps Order Processing API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/migrate.js",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/server.ts\" --test-coverage-exclude=\"src/migrate.ts\" --test-coverage-exclude=\"src/tracing.ts\" --test-coverage-exclude=\"src/kinesis.ts\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 test/*.test.ts",
    "lint": "eslint src test scripts",
    "audit": "node ../../scripts/npm-audit-gate.mjs",
    "contract-check": "tsx scripts/contract-check.ts",
    "openapi:lint": "spectral lint --ruleset .spectral.yaml --fail-severity=error openapi.yaml"
  },
  "keywords": [
    "express",
    "api",
    "eks",
    "kubernetes",
    "typescript"
  ],
  "author": "CloudOps",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-kinesis": "^3.511.0",
    "@aws-sdk/client-secrets-manager": "^3.511.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "pg": "^8.11.3",
    "pino": "^9.0.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
