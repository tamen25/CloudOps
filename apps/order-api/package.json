{
  "name": "order-api",
  "version": "1.0.0",
  "description": "CloudOps Order Processing API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
