{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Security posture for CloudOps — compliance scanner findings, MTTD/MTTR SLOs, auto-remediation health, kube-bench CIS benchmark results, and Falco runtime alerts. Sourced from CloudWatch namespace CloudOps/Security and CloudWatch Logs Insights on Lambda structured logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Security Runbooks",
      "tooltip": "Open CloudOps security runbooks",
      "type": "link",
      "url": "https://github.com/your-org/your-repo/blob/main/docs/runbooks/"
    },
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "SLO Dashboard",
      "tooltip": "Open order-api SLO dashboard",
      "type": "link",
      "url": "/d/slo-dashboard"
    }
  ],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Security Posture Summary",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Total findings currently in OPEN status across all severities and sources. Green=0, Yellow=1–5, Red=6+.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "Clean" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": {},
          "expression": "SUM(SEARCH('{CloudOps/Security,Severity} MetricName=\"FindingsOpen\"', 'Sum', 300))",
          "id": "total_open",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default"
        }
      ],
      "title": "Total Open Findings",
      "type": "stat"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "CRITICAL findings currently open. Any non-zero value triggers a page via SNS.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "None" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["CRITICAL"] },
          "expression": "",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "CRITICAL Open Findings",
      "type": "stat"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Mean time to detect new security findings. SLO target: ≤5 min (300 s) for CRITICAL. Green=within SLO, Red=breach.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": {},
          "expression": "AVG(SEARCH('{CloudOps/Security,Severity} MetricName=\"MeanTimeToDetect\"', 'Average', 300))",
          "id": "mttd_avg",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default"
        }
      ],
      "title": "MTTD (Mean Time to Detect)",
      "type": "stat"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Mean time to auto-remediate findings. SLO target: ≤15 min (900 s). Green=within SLO, Red=breach.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 900 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Outcome": ["success"] },
          "expression": "",
          "matchExact": true,
          "metricName": "MeanTimeToRemediate",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Average"
        }
      ],
      "title": "MTTR (Auto-Remediation)",
      "type": "stat"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Ratio of successful auto-remediation attempts in the last 5 minutes. Target: ≥80%. Green=above target, Red=below.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Outcome": ["success"] },
          "expression": "",
          "id": "rem_success",
          "matchExact": true,
          "metricName": "AutoRemediationAttempts",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Outcome": ["failure"] },
          "expression": "",
          "id": "rem_failure",
          "matchExact": true,
          "metricName": "AutoRemediationAttempts",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "expression": "100 * rem_success / (rem_success + rem_failure + 0.001)",
          "hide": false,
          "id": "success_rate",
          "queryMode": "Metrics",
          "refId": "C",
          "region": "default"
        }
      ],
      "title": "Auto-Remediation Success Rate",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 200,
      "title": "Security SLOs",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Mean time to detect security findings over the selected time range, broken down by severity. Red threshold line at 300 s (5 min) represents the CRITICAL SLO target.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "seconds",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 300 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["CRITICAL"] },
          "expression": "",
          "label": "CRITICAL",
          "matchExact": true,
          "metricName": "MeanTimeToDetect",
          "namespace": "CloudOps/Security",
          "period": "${__interval_ms}",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Average"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["HIGH"] },
          "expression": "",
          "label": "HIGH",
          "matchExact": true,
          "metricName": "MeanTimeToDetect",
          "namespace": "CloudOps/Security",
          "period": "${__interval_ms}",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "default",
          "statistic": "Average"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["MEDIUM"] },
          "expression": "",
          "label": "MEDIUM",
          "matchExact": true,
          "metricName": "MeanTimeToDetect",
          "namespace": "CloudOps/Security",
          "period": "${__interval_ms}",
          "queryMode": "Metrics",
          "refId": "C",
          "region": "default",
          "statistic": "Average"
        }
      ],
      "title": "MTTD over Time (SLO: 5 min for CRITICAL)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Mean time to auto-remediate findings over the selected time range. Red threshold line at 900 s (15 min) represents the SLO target.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "seconds",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 900 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Outcome": ["success"] },
          "expression": "",
          "label": "Success",
          "matchExact": true,
          "metricName": "MeanTimeToRemediate",
          "namespace": "CloudOps/Security",
          "period": "${__interval_ms}",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Average"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Outcome": ["failure"] },
          "expression": "",
          "label": "Failure",
          "matchExact": true,
          "metricName": "MeanTimeToRemediate",
          "namespace": "CloudOps/Security",
          "period": "${__interval_ms}",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "default",
          "statistic": "Average"
        }
      ],
      "title": "MTTR over Time (SLO: 15 min)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Current open finding count by severity. Filtered by $severity template variable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 6 }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "CRITICAL" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "HIGH" },     "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "MEDIUM" },   "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "LOW" },      "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 12,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["CRITICAL"] },
          "expression": "",
          "label": "CRITICAL",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["HIGH"] },
          "expression": "",
          "label": "HIGH",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["MEDIUM"] },
          "expression": "",
          "label": "MEDIUM",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "C",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Severity": ["LOW"] },
          "expression": "",
          "label": "LOW",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "D",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "Open Findings by Severity",
      "type": "bargauge"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "description": "Distribution of current open findings by source system. Filtered by $source template variable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "unit": "short"
