        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 13,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "pie",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Source": ["compliance-scanner"] },
          "expression": "",
          "label": "Compliance Scanner",
          "matchExact": true,
          "metricName": "FindingsOpen",
          "namespace": "CloudOps/Security",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "Source": ["falco"] },
          "expression": "",
          "label": "Falco",
