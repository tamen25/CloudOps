{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SLO tracking for order-api — availability, latency, error budget burn rate, and incident history. Powered by Prometheus recording rules + CloudWatch Lambda metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "SLO Runbooks",
      "tooltip": "Open SLO runbooks",
      "type": "link",
      "url": "https://github.com/tamen25/CloudOps/blob/main/docs/runbooks/"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SLO Status Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current 5-minute availability SLI from Prometheus recording rule. Green = at or above SLO target. Click for availability runbook.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "links": [
            {
              "targetBlank": true,
              "title": "Availability Runbook",
              "url": "https://github.com/tamen25/CloudOps/blob/main/docs/runbooks/slo-availability-fast-burn.md"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 98,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "job:slo_availability:ratio_rate5m{service=\"$service\"} * 100",
          "instant": true,
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "title": "Current Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Fraction of the 30-day availability error budget still available. Derived from the 3d burn-rate recording rule. Green ≥50%, yellow ≥10%, red <10%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "links": [
            {
              "targetBlank": true,
              "title": "Error Budget Runbook",
              "url": "https://github.com/tamen25/CloudOps/blob/main/docs/runbooks/slo-error-budget-low.md"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "job:slo_error_budget:availability_remaining{service=\"$service\"} * 100",
          "instant": true,
          "legendFormat": "Budget Remaining",
          "refId": "A"
        }
      ],
      "title": "Error Budget Remaining",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Projected hours until the 30-day error budget is exhausted at the current 1h burn rate. Red <24h (page now), yellow <168h (7 days), green = healthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "min": 0,
          "noValue": "∞",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "green", "value": 168 }
            ]
          },
          "unit": "h"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "clamp_min(\n  (\n    job:slo_error_budget:availability_remaining{service=\"$service\"} /\n    clamp_min(\n      (1 - job:slo_availability:ratio_rate1h{service=\"$service\"}) / (1 - $slo_target / 100),\n      0.001\n    )\n  ) * 720,\n  0\n)",
          "instant": true,
          "legendFormat": "Hours Until Exhaustion",
          "refId": "A"
        }
      ],
      "title": "Hours Until Exhaustion",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "How fast the availability error budget is being consumed. 1.0 = nominal rate. >6 = slow burn (open ticket). >14.4 = fast burn (page immediately). Reference: Google SRE Workbook.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - job:slo_availability:ratio_rate1h{service=\"$service\"}) / (1 - $slo_target / 100)",
          "instant": true,
          "legendFormat": "Burn Rate 1h",
          "refId": "A"
        }
      ],
      "title": "Burn Rate (1h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Error Budget Burn",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_ds}" },
      "description": "Error budget remaining % as published by the SLO Lambda every 5 minutes to CloudWatch namespace CloudOps/SLO. Sentinel value of -1 indicates a data-collection failure (Prometheus unreachable).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "max": 105,
          "min": -5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["last", "min"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "alias": "Error Budget Remaining",
          "dimensions": {
            "Environment": ["$environment"],
            "Service": ["$service"]
          },
          "expression": "",
          "id": "",
          "matchExact": true,
          "metricName": "ErrorBudgetRemaining",
          "namespace": "CloudOps/SLO",
          "period": "300",
          "refId": "A",
          "region": "default",
          "statistics": ["Average"]
        }
      ],
      "title": "Error Budget Remaining % (CloudWatch, 30d)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_ds}" },
      "description": "Burn rate for 1h and 6h windows from CloudWatch. Threshold lines: orange = 6x (slow burn — open ticket), red = 14.4x (fast burn — page now).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "decimals": 2,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "alias": "Burn Rate 1h",
          "dimensions": {
            "Environment": ["$environment"],
            "Service": ["$service"]
          },
          "expression": "",
          "id": "",
          "matchExact": true,
          "metricName": "BurnRate1h",
          "namespace": "CloudOps/SLO",
          "period": "300",
          "refId": "A",
          "region": "default",
          "statistics": ["Average"]
        },
        {
          "alias": "Burn Rate 6h",
          "dimensions": {
            "Environment": ["$environment"],
            "Service": ["$service"]
          },
          "expression": "",
          "id": "",
          "matchExact": true,
          "metricName": "BurnRate6h",
          "namespace": "CloudOps/SLO",
          "period": "3600",
          "refId": "B",
          "region": "default",
          "statistics": ["Average"]
        }
      ],
      "title": "Burn Rate 1h & 6h (CloudWatch)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Percentage of the 30-day error budget consumed for availability vs latency SLOs. Derived from Prometheus recording rules (3d burn rate as 30d proxy). Red >100% = SLO breached.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 110,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 90 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 16 },
      "id": 7,
      "options": {
        "displayMode": "lcd",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - job:slo_error_budget:availability_remaining{service=\"$service\"}) * 100",
          "instant": true,
          "legendFormat": "Availability Budget Consumed",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - job:slo_error_budget:latency_remaining{service=\"$service\"}) * 100",
          "instant": true,
          "legendFormat": "Latency Budget Consumed",
          "refId": "B"
        }
      ],
      "title": "Error Budget Consumed — Availability vs Latency (30d)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "SLI Details",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Availability SLI (% non-5xx requests) over the $window range. The dashed red line is the SLO target at $slo_target%. Drops below the line represent SLO breaches.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          },
          "mappings": [],
          "max": 100.5,
          "min": 98,
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLO Target" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_requests_total{job=\"$service\",status!~\"5..\"}[$window])) / sum(rate(http_requests_total{job=\"$service\"}[$window])) * 100",
          "legendFormat": "Availability SLI",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "vector($slo_target)",
          "legendFormat": "SLO Target",
          "refId": "B"
        }
      ],
      "title": "Availability SLI over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Request latency percentiles from the http_request_duration_seconds Prometheus histogram. The dashed line at 300ms is the latency SLO threshold (95% of requests must be below this).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "mappings": [],
          "min": 0,
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLO Threshold (300ms)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"$service\"}[$window])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"$service\"}[$window])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"$service\"}[$window])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "vector(300)",
          "legendFormat": "SLO Threshold (300ms)",
          "refId": "D"
        }
      ],
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Request throughput split into successful (non-5xx) and failed (5xx) requests per second. Stacked view shows relative share of bad traffic.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": {
            "fillOpacity": 50,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "mappings": [],
          "min": 0,
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Good Requests" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Bad Requests (5xx)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 33 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_requests_total{job=\"$service\",status!~\"5..\"}[$window]))",
          "legendFormat": "Good Requests",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_requests_total{job=\"$service\",status=~\"5..\"}[$window]))",
          "legendFormat": "Bad Requests (5xx)",
          "refId": "B"
        }
      ],
      "title": "Good vs Bad Requests (stacked)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Heatmap of request latency distribution from the Prometheus histogram. Brighter cells indicate more requests in that latency bucket. Helps identify latency bimodality or tail spikes.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 33 },
      "id": 11,
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Oranges",
          "steps": 64
        },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "show": true, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "s" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"$service\"}[$window])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Latency Distribution Heatmap",
      "type": "heatmap"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 103,
      "title": "Alerts & Incidents",
      "type": "row"
    },
    {
      "datasource": { "uid": "-- Grafana --" },
      "description": "All firing or pending SLO alerts for $service. Alerts are defined in modules/observability/slo.tf via PrometheusRule CRDs. Click an alert to open its Alertmanager entry.",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 43 },
      "id": 12,
      "options": {
        "alertInstanceLabelFilter": "service=$service",
        "alertName": "SLO",
        "dashboardAlerts": false,
        "groupBy": ["service"],
        "groupMode": "tags",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": false,
          "pending": true
        },
        "tags": ["slo"],
        "viewMode": "list"
      },
      "title": "Firing SLO Alerts",
      "type": "alertlist"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_ds}" },
      "description": "Last 10 SLO calculation events from the error-budget-tracker Lambda. Pulled from CloudWatch Logs Insights. Fields are parsed from the structured JSON logged by the Lambda handler.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "errorBudgetRemaining" },
            "properties": [
              { "id": "displayName", "value": "Budget Remaining %" },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "green", "value": 50 }
                  ]
                }
              }
            ]
          },
          {
