{
  "annotations": { "list": [] },
  "description": "Distributed tracing via Tempo — service map, search, latency",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "edges": {},
        "nodes": {}
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{}"
        }
      ],
      "title": "Service Map",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 2,
      "options": {
        "search": {
          "hide": false
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${tempo_ds}" },
          "limit": 20,
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces",
          "filters": [
            {
              "id": "service-name",
              "operator": "=",
              "scope": "resource",
              "tag": "service.name",
              "value": ["$service"],
              "valueType": "string"
            }
          ]
        }
      ],
      "title": "Trace Search — $service",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service=\"$service\"}[5m])) by (le, service))",
          "legendFormat": "p95 {{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service=\"$service\"}[5m])) by (le, service))",
          "legendFormat": "p50 {{service}}",
          "refId": "B"
        }
      ],
      "title": "p50 / p95 Trace Duration",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["tempo", "traces"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Tempo Datasource",
        "multi": false,
        "name": "tempo_ds",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus Datasource",
        "multi": false,
        "name": "prom_ds",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "text": "order-api", "value": "order-api" },
        "hide": 0,
        "includeAll": false,
        "label": "Service",
        "multi": false,
        "name": "service",
        "options": [
          { "selected": true, "text": "order-api", "value": "order-api" }
        ],
        "query": "order-api",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Tempo Traces",
  "uid": "tempo-traces",
  "version": 1
}
