# staging.tfvars.example — prod-shaped behavior, staging-priced runtime.
#
# Closes backlog #46. Renamed from prod-test.tfvars.example; the previous
# `environment = "prod"` value collided with real prod state keys whenever the
# same backend bucket was used. Staging now lives at its own state key
# (`staging/<stack>/terraform.tfstate`) and exercises every prod behavior path
# (auth, security scans, manifest validation, migrations, rollout, integration
# tests, rollback) at lower cost.
#
# Allowed differences vs prod (per docs/environment-contract.md):
#   - compute size, retention, destroy-safety locks, NAT/HA spend, data durability
#
# Required parity vs prod (per docs/environment-contract.md):
#   - deploy stages, approvals, OIDC auth, security scans, migrations,
#     integration tests, rollback path, state layout, drift detection
#
# Destroy-safety overrides (intentional — staging IS destroyable):
#       database_deletion_protection         = false
#       database_skip_final_snapshot         = true
#       buckets_force_destroy                = true
#       cloudtrail_object_lock_enabled       = false
#       backup_vault_lock_enabled            = false
#       database_secret_recovery_window_days = 0
#
# Apply:
#   ./scripts/tf-init.sh
#   terraform apply -var-file=environments/staging.tfvars
#
# Tear down:
#   ./destroy.sh           # preserves OIDC + Route 53
#   ./destroy.sh --nuke-bootstrap   # wipes everything

environment  = "staging"
project_name = "cloudops"

# ── Module toggles (full prod set) ───────────────────────────────────────────
enable_networking    = true
enable_eks           = true
enable_database      = true
enable_ingress       = true
enable_observability = true
enable_slo           = true
enable_security      = true
enable_finops        = true
enable_self_healing  = true
enable_backup        = true
enable_compliance    = true
destroy_all          = false

# ── EKS — 3-AZ on-demand ──────────────────────────────────────────────────────
az_count                = 3
eks_node_instance_types = ["m6i.large"]
eks_node_min_size       = 3
eks_node_max_size       = 12
eks_node_desired_size   = 3
eks_node_capacity_type  = "ON_DEMAND"
enable_nat_gateway      = true

# ── ALB / WAF ────────────────────────────────────────────────────────────────
allowed_cidr_blocks      = ["0.0.0.0/0"]   # tighten in real prod
enable_waf               = true
waf_rate_limit_per_5min  = 2000
waf_logging_enabled      = true

# ── VPC flow logs to S3 + Athena ─────────────────────────────────────────────
enable_flow_logs         = true
flow_logs_destination    = "s3"
flow_logs_retention_days = 30

# ── RDS — multi-AZ + read replica + rotation ─────────────────────────────────
database_instance_class               = "db.r6g.large"
database_multi_az                     = true
database_create_read_replica          = true
database_backup_retention_period      = 30
database_performance_insights_enabled = true

# DESTROY-SAFE OVERRIDES (NEVER use in real prod) ─────────────────────────────
database_deletion_protection         = false   # real prod: true
database_skip_final_snapshot         = true    # real prod: false
database_secret_recovery_window_days = 0       # real prod: 7

# Rotation: leave OFF unless you've deployed the SAR rotation Lambda separately
# and have its ARN. Setting database_rotation_enabled=true without an ARN is a no-op.
database_rotation_enabled    = false
database_rotation_lambda_arn = ""

# ── Observability — HA + Mimir + KMS CMKs + lifecycle ────────────────────────
metrics_long_term_storage         = "mimir"
loki_replication_factor           = 3
loki_write_replicas               = 3
loki_read_replicas                = 3
prometheus_replicas               = 2
prometheus_retention              = "6h"        # Mimir owns long-term
tempo_ingester_replicas           = 3
tempo_metrics_generator_enabled   = true
enable_alertmanager               = true

# Bucket hardening
buckets_versioning              = true
buckets_kms_cmk                 = true
buckets_glacier_transition_days = 30
buckets_expiration_days         = 365
# DESTROY-SAFE OVERRIDE — real prod: false
buckets_force_destroy           = true

# Cross-region replication (optional — set ARNs to enable)
buckets_replication_destination_arn = ""
buckets_replication_role_arn        = ""

# ── AWS Backup vault ─────────────────────────────────────────────────────────
backup_daily_retention_days   = 7
backup_weekly_retention_days  = 30
backup_monthly_retention_days = 365
# DESTROY-SAFE OVERRIDE — real prod: true (locks the vault)
backup_vault_lock_enabled            = false
backup_vault_lock_min_retention_days = 7
backup_vault_lock_max_retention_days = 365

# ── Compliance ───────────────────────────────────────────────────────────────
enable_cloudtrail                     = true
enable_guardduty                      = true
guardduty_eks_protection              = true
guardduty_s3_protection               = true
guardduty_malware_protection          = false   # extra cost; off for test
enable_config                         = true
enable_security_hub                   = true
config_conformance_packs              = []      # paste S3 URIs to add packs
# DESTROY-SAFE OVERRIDE — real prod: true
cloudtrail_object_lock_enabled        = false
cloudtrail_object_lock_retention_days = 90

# ── Self-healing — live remediation, not dry-run ─────────────────────────────
self_healing_dry_run                 = false
self_healing_min_healthy_pods        = 3
self_healing_max_scale_out_pods      = 20
self_healing_rollback_on_error_rate  = 5

# ── Secrets / app integration ────────────────────────────────────────────────
enable_external_secrets   = true
grafana_alert_webhook_url = ""           # paste Slack/PD/SNS webhook to enable

# Closes backlog #37 — explicit ARN scoping for ESO + order-api IRSA in non-dev
# envs. Replace these with real ARNs from your account before applying. The
# `*-db-credentials-*` pattern matches the Secrets Manager suffix appended by
# AWS. The order-api API key ARN is the single secret the app reads via
# API_KEY_SECRET_ARN; it must also match `secrets.ORDER_API_KEY_SECRET_ARN` in
# GitHub (the deploy step asserts this).
external_secrets_allowed_arns = [
  # "arn:aws:secretsmanager:us-east-1:<account>:secret:cloudops-db-credentials-*",
  # "arn:aws:secretsmanager:us-east-1:<account>:secret:cloudops-order-api-key-*",
]
order_api_api_key_secret_arn  = ""        # paste cloudops-order-api-key ARN once provisioned

# ── Database logging policy (backlog #41) ────────────────────────────────────
# Production should not log every DML payload. These settings capture slow
# queries + DDL events for audit without leaking customer data.
# - log_statement="ddl"            — DDL only (CREATE/ALTER/DROP)
# - log_duration=false             — rely on min-duration threshold instead
# - log_min_duration_statement=500 — log queries slower than 500 ms
# Adjust the threshold per your latency SLO. Logs land in CloudWatch Logs
# with the standard RDS retention; tighten retention in your CW log group
# policy or via `database_*` vars below.
database_log_connections                  = true
database_log_disconnections               = true
database_log_duration                     = false
database_log_statement                    = "ddl"
database_log_min_duration_statement_ms    = 500

# ── EKS control-plane endpoint (backlog #42) ─────────────────────────────────
# Production should keep the public endpoint OFF and reach the API server via
# private runners / VPN / bastion. If you need a one-shot emergency window,
# flip eks_endpoint_public_access=true *and* tighten eks_endpoint_public_access_cidrs
# to your admin egress IPs — never leave it as 0.0.0.0/0 in prod.
eks_endpoint_private_access      = true
eks_endpoint_public_access       = false
eks_endpoint_public_access_cidrs = ["0.0.0.0/0"]   # ignored while public access is false

# ── FinOps ──────────────────────────────────────────────────────────────────
cost_budget_monthly_usd        = 500
cost_alert_email               = ""
cost_anomaly_threshold_percent = 15
